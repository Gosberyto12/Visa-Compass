# Server-only environment variables. Never prefix secrets with NEXT_PUBLIC_.
# Keep provider integration disabled until Sherpa grants access and the API contract is confirmed.
VISA_PROVIDER=mock
VISA_PROVIDER_TIMEOUT_MS=8000

# Supabase public project values. These are safe to expose through the browser.
# Never put a service-role or secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key. Needed only for the account-deletion action; never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Add these only after Sherpa provides credentials and exact API documentation.
SHERPA_API_BASE_URL=
SHERPA_API_KEY=
SHERPA_API_TIMEOUT_MS=8000

# Production rate limiting should use a shared store (e.g. Redis/Upstash).
# The included in-memory limiter is only a local development safeguard.
